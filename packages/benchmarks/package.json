{
  "name": "@tokentrim/benchmarks",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx src/run-benchmark.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tokentrim/core": "workspace:*",
    "@tokentrim/shared": "workspace:*",
    "@tokentrim/analyzer": "workspace:*",
    "@tokentrim/compressor": "workspace:*",
    "@tokentrim/tokenizer": "workspace:*",
    "@tokentrim/verifier": "workspace:*",
    "@tokentrim/privacy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.3"
  }
}