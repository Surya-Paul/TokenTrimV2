{
  "name": "tokentrim",
  "version": "1.0.0",
  "private": true,
  "description": "Model-aware, local-first LLM input optimization engine",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @tokentrim/api dev\" \"pnpm --filter @tokentrim/web dev\"",
    "dev:api": "pnpm --filter @tokentrim/api dev",
    "dev:web": "pnpm --filter @tokentrim/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" run test",
    "typecheck": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" run typecheck",
    "lint": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" run lint",
    "benchmark": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" run benchmark",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}