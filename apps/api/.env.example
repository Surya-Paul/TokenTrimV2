# ============================================================
# TokenTrim API Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Groq API key (https://console.groq.com → API Keys)
GROQ_API_KEY=gsk_your_key_here

# Groq model to use for AI compression
GROQ_MODEL=qwen/qwen3.8-27b

# ── Optional ─────────────────────────────────────────────────
# Server listen port
PORT=3001

# Server bind address
HOST=0.0.0.0

# Allowed CORS origin — must match the deployed web client URL.
# In production, set this to your web client's exact origin
# (e.g. https://tokentrim.example.com).
CORS_ORIGIN=http://localhost:5173

# Maximum request body size (e.g. 1mb, 500kb, 2mb).
# The server rejects payloads larger than this limit.
REQUEST_SIZE_LIMIT=1mb

# Timeout for upstream Groq API calls (milliseconds)
REQUEST_TIMEOUT_MS=60000

# Maximum compression requests per minute per IP
RATE_LIMIT_MAX=30

# Node environment
NODE_ENV=development

# Pino log level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
