# ============================================================
# TokenTrim Web Client — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Only VITE_-prefixed variables are embedded in the browser
# bundle at build time. Never put server secrets here.
# ============================================================

# Base URL of the TokenTrim API server.
# In development this is used by the Vite proxy.
# For production builds, set this to your deployed API origin
# (e.g. https://api.tokentrim.example.com) before running `pnpm build`.
VITE_API_URL=http://localhost:3001
